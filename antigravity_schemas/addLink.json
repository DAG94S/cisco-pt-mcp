{"name":"addLink","description":"Connect two devices with a cable. Both interfaces must be free (in_use=false in getNetwork output). If unsure, call getNetwork first.","parameters":{"properties":{"device1Interface":{"description":"Free interface on device 1.","pattern":"^(GigabitEthernet|FastEthernet|Ethernet|Serial|Gi|Fa|Se)(\\d+)?(/\\d+){0,2}$","type":"string"},"device1Name":{"type":"string"},"device2Interface":{"description":"Free interface on device 2.","pattern":"^(GigabitEthernet|FastEthernet|Ethernet|Serial|Gi|Fa|Se)(\\d+)?(/\\d+){0,2}$","type":"string"},"device2Name":{"type":"string"},"linkType":{"description":"Cable type. Use 'straight' for most LAN, 'cross' for PC-PC, 'serial' for WAN.","enum":["straight","cross","fiber","serial","auto"],"type":"string"}},"required":["device1Name","device1Interface","device2Name","device2Interface","linkType"],"type":"object"}}